{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/engineers",
      "destination": "/log"
    },
    {
      "source": "/rideworld/log",
      "destination": "/log"
    },
    {
      "source": "/R/:id",
      "destination": "/ride"
    },
    {
      "source": "/r/:id",
      "destination": "/ride"
    },
    {
      "source": "/W/:id",
      "destination": "/w"
    },
    {
      "source": "/w/:id",
      "destination": "/w"
    },
    {
      "source": "/W/:id/:t",
      "destination": "/w"
    },
    {
      "source": "/w/:id/:t",
      "destination": "/w"
    }
  ],
  "headers": [
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
